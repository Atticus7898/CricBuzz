# ==============================================================================
# Cricbuzz LiveStats - Environment Configuration Template
# Copy this file to .env and customize with your local credentials.
# ==============================================================================

# Database Configuration (MySQL 8.0/9.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cricbuzz_db
DB_POOL_NAME=cricbuzz_pool
DB_POOL_SIZE=5

# Cricbuzz RapidAPI Credentials
RAPIDAPI_KEY=your_cricbuzz_rapidapi_key_here
RAPIDAPI_HOST=cricbuzz-cricket.p.rapidapi.com

# Application Mode & Settings
APP_ENV=development
LOG_LEVEL=INFO
USE_MOCK_ON_API_FAILURE=true
